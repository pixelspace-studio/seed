# Seed — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — at least one AI provider key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (Brave Search API — https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Model (default: claude-sonnet-4-6)
# Options: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
MODEL=claude-sonnet-4-6

# Server
SEED_PORT=9999

# Sliding context window (optional — defaults are fine for most cases)
# MAX_CONTEXT_TOKENS=180000   # Sonnet/Haiku: 180000, Opus: 900000
# CONTEXT_KEEP_RECENT=10      # min messages always kept
# CHARS_PER_TOKEN=4           # token estimator: 4=prose, 3.5=code-heavy
